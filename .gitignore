# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# editor / local tooling (may contain MCP or machine-specific paths)
.cursor/

# Claude Code local worktrees (full tree copies; not part of the app)
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Fresha availability spike — captured network dumps may contain PII
spikes/fresha-availability/captured/
spikes/fresha-availability/node_modules/

/.tmp/

/supabase/.temp/
