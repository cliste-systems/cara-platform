# Copy to `.env.local` and fill in values for local dev.
# Production values live in Vercel project settings.

# Supabase (required for auth, dashboard, admin console)
NEXT_PUBLIC_SUPABASE_URL=https://rtoebbwzwxcnscsxghww.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: Supabase Management API token for scripts/patch-supabase-auth-urls.ts
# SUPABASE_ACCESS_TOKEN=

# LiveKit — voice preview, admin demo calls (browser WebRTC → voice worker)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Must match the LiveKit Cloud agent registration name:
# LIVEKIT_AGENT_NAME=cliste-retail-node
# LIVEKIT_INFERENCE_TTS_MODEL=cartesia/sonic-3.6
# LIVEKIT_INFERENCE_TTS_VOICE=d79d2b77-9192-4e10-9407-5d43ca034803

# Transactional email (signup, invites, owner alerts) — Resend
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=hello@hellocara.ie
# RESEND_FROM_NAME=HelloCara

# Admin platform spend tracker (/admin/payments/platform-spend)
# OPENROUTER_MANAGEMENT_KEY=   # OpenRouter credits/analytics API (falls back to OPENROUTER_API_KEY)
# PLATFORM_SPEND_USD_TO_EUR=0.92
# VOICE_COST_USD_TO_EUR=0.92

# Resend — HelloCara email
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=hello@hellocara.ie
# RESEND_FROM_NAME=HelloCara
# RESEND_HELLO_EMAIL=hello@hellocara.ie
# RESEND_HELLO_NAME=HelloCara
# RESEND_BILLING_EMAIL=billing@hellocara.ie
# RESEND_BILLING_NAME=HelloCara Billing
# RESEND_CLISTE_EMAIL=hello@clistesystems.ie
# RESEND_CLISTE_NAME=Cliste Systems
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx  # optional env override; DB config is supported
