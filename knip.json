{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "middleware.ts",
    "src/app/**/{page,layout,template,loading,error,not-found,route,default}.{ts,tsx}",
    "scripts/*.ts",
    "src/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts"
  ],
  "ignore": [
    "src/components/ui/**"
  ],
  "ignoreDependencies": [
    "server-only",
    "tw-animate-css",
    "shadcn",
    "tailwindcss"
  ],
  "ignoreExportsUsedInFile": true
}
